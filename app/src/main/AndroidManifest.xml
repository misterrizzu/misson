        </receiver>

        <!-- 11. Lock Screen Widget -->
        <receiver
            android:name=".widget.LockScreenWidgetProvider"
            android:exported="true"
            android:label="Mission 10L - Lock Screen">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
