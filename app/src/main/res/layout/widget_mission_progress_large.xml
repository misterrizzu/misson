<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_premium_card"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- Progress Ring Container -->
    <RelativeLayout
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/img_ring"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true"
            android:contentDescription="Progress Ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24%"
                android:textColor="@color/widget_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp"
                android:letterSpacing="0.1" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Metrics Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Title Row with Gold Crown -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_gold_crown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="MISSION 10L"
                    android:textColor="@color/widget_accent_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_progress_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_widget_capsule_checked"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🔥 23d Streak"
                android:textColor="@color/widget_accent_gold"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Revenue Number -->
        <TextView
            android:id="@+id/txt_rev_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="₹2,45,000"
            android:textColor="@color/widget_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Target Remaining -->
        <TextView
            android:id="@+id/txt_remaining_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remaining: ₹7,55,000"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <!-- Sub-Metrics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_today_rev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today: ₹1,350"
                android:textColor="@color/widget_accent_gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_month_rev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Month: ₹18,750"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bottom Quote -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✨ Every Rupee Counts."
            android:textColor="@color/widget_accent_gold"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>
</LinearLayout>
