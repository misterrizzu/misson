<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_premium_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row: Date & Completion -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="🎯 TODAY'S MISSION"
            android:textColor="@color/widget_accent_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/txt_today_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_widget_capsule_checked"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="68% DONE"
            android:textColor="@color/widget_accent_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Checklist 2-Column Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chk_namaz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_widget_capsule_checked"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="✔ 5 Daily Prayers (Namaz)"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chk_boxabl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_widget_capsule_checked"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="✔ Boxabl Clip Posted"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chk_cantina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_capsule_checked"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="✔ Cantina Clip Posted"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chk_workout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_widget_capsule_unchecked"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="☐ 30 Min Workout"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chk_journal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_widget_capsule_checked"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="✔ Read 10 Minutes"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chk_sleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_capsule_unchecked"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="☐ Slept Before Midnight"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
