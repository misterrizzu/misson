<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_red"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Title & Streak Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="⚡ TODAY'S MISSION"
            android:textColor="#FF1744"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/txt_today_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_red_pill_glow"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🔥 0 STREAK"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Content Row: Ring & Interactive Checklist -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Progress Ring Box -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_today_ring"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="Ring" />

            <TextView
                android:id="@+id/txt_today_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0%"
                android:textColor="#FF1744"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Checklist List View -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chk_namaz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_widget_item_unchecked"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="☐ 5 Daily Prayers"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/chk_boxabl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_widget_item_unchecked"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="☐ Boxabl Clip Posted"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/chk_cantina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_widget_item_unchecked"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="☐ Cantina Clip Posted"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/chk_workout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/bg_widget_item_unchecked"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="☐ 30 Min Workout"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/chk_journal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_item_unchecked"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="☐ Sleep Before Midnight"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
