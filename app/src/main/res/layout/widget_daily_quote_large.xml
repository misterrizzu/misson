<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_red"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txt_quote_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISCIPLINE"
        android:textColor="#FF1744"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_quote_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:gravity="center"
        android:text="&quot;Discipline equals freedom.&quot;"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/txt_quote_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="— Mission 10L Mindset"
        android:textColor="#AAAAAA"
        android:textSize="10sp" />
</LinearLayout>
