<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_premium_card"
    android:padding="20dp">

    <TextView
        android:id="@+id/txt_quote_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="“"
        android:textColor="@color/widget_accent_gold"
        android:textSize="48sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/txt_quote_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Small actions repeated daily create massive success."
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/txt_quote_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="— Mission 10L Mindset"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_quote_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_widget_secondary_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="Keep Going ⚡"
        android:textColor="@color/widget_accent_gold"
        android:textSize="10sp"
        android:textStyle="bold" />
</RelativeLayout>
