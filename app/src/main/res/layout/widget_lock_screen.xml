<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_widget"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_secondary_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Mission Icon & % -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_gold_crown" />

        <TextView
            android:id="@+id/txt_lock_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="24%"
            android:textColor="@color/widget_accent_gold"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="•"
        android:textColor="@color/widget_border" />

    <!-- Revenue -->
    <TextView
        android:id="@+id/txt_lock_rev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹2,45,000"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="•"
        android:textColor="@color/widget_border" />

    <!-- Streak -->
    <TextView
        android:id="@+id/txt_lock_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 23d"
        android:textColor="@color/widget_accent_orange"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:text="•"
        android:textColor="@color/widget_border" />

    <!-- Next Task -->
    <TextView
        android:id="@+id/txt_lock_next_task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Next: 🎬 Boxabl Clip"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
